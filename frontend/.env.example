# --- Backend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Firebase (Project settings > General > Your apps > Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps Platform ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID (Maps Management). Defaults to Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Local development only (ignored in production builds): lets you test the ML flow before Firebase is set up.
NEXT_PUBLIC_DEV_SKIP_AUTH=false
